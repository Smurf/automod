# Pinned upstream versions and URLs for automod software stack.
# Sourced by every build/*.sh script so the whole stack is reproducible.
# ARCHIVE_BASE may be overridden by callers (default set in lib.sh).
#
# Multi-version support: the *_VERSIONS lists hold EVERY version built into
# the module tree (e.g. modulefiles/mpi/mpich/4.3.2 and mpich/4.2.3 both
# exist). The first entry is the newest and acts as the pairing partner
# where two lists go together (netCDF-C pairs with netCDF-Fortran by index).
# Intel oneAPI versions are apt repo version suffixes; for each pinned
# version the matching versioned packages are installed side by side
# (/opt/intel/oneapi/{compiler,mpi,mkl}/<ver>).

export MPICH_VERSIONS="4.3.2 4.2.3"

export OPENMPI_VERSIONS="4.1.8 4.1.6"

export ONEAPI_COMPILER_VERSIONS="2026.2 2025.3"
export INTEL_MPI_VERSIONS="2021.19 2021.18"
export MKL_VERSIONS="2026.2 2025.3"

export HDF5_VERSION=1.14.6
# HDF5 release assets have used underscore naming for some tags; fall back to it.
export HDF5_URL="https://github.com/HDFGroup/hdf5/releases/download/hdf5-${HDF5_VERSION}/hdf5-${HDF5_VERSION}.tar.gz"
export HDF5_URL_ALT="https://github.com/HDFGroup/hdf5/releases/download/hdf5_${HDF5_VERSION}/hdf5-${HDF5_VERSION}.tar.gz"

# netCDF-C pairs with netCDF-Fortran by list index:
#   4.9.3 <-> 4.6.2 and 4.9.2 <-> 4.6.1
export NETCDF_C_VERSIONS="4.9.3 4.9.2"
export NETCDF_FORTRAN_VERSIONS="4.6.2 4.6.1"

export SPARTA_TAG=27Aug2026
export SPARTA_URL="https://github.com/sparta/sparta/archive/refs/tags/${SPARTA_TAG}.tar.gz"

# --- per-version URL helpers (tarball names depend on the version) ---------
mpich_url()         { printf 'https://www.mpich.org/static/downloads/%s/mpich-%s.tar.gz' "$1" "$1"; }
openmpi_url()       { printf 'https://download.open-mpi.org/release/open-mpi/v%s/openmpi-%s.tar.gz' "${1%.*}" "$1"; }
netcdf_c_url()      { printf 'https://downloads.unidata.ucar.edu/netcdf-c/%s/netcdf-c-%s.tar.gz' "$1" "$1"; }
netcdf_c_url_alt()  { printf 'https://github.com/Unidata/netcdf-c/archive/refs/tags/v%s.tar.gz' "$1"; }
netcdf_f_url()      { printf 'https://downloads.unidata.ucar.edu/netcdf-fortran/%s/netcdf-fortran-%s.tar.gz' "$1" "$1"; }
netcdf_f_url_alt()  { printf 'https://github.com/Unidata/netcdf-fortran/archive/refs/tags/v%s.tar.gz' "$1"; }
