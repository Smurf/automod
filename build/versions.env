# Pinned upstream versions and URLs for automod software stack.
# Sourced by every build/*.sh script so the whole stack is reproducible.
# ARCHIVE_BASE may be overridden by callers (default set in lib.sh).

export MPICH_VERSION=4.3.2
export MPICH_URL="https://www.mpich.org/static/downloads/${MPICH_VERSION}/mpich-${MPICH_VERSION}.tar.gz"

export OPENMPI_VERSION=4.1.8
export OPENMPI_URL="https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-${OPENMPI_VERSION}.tar.gz"

export HDF5_VERSION=1.14.6
# HDF5 release assets have used underscore naming for some tags; fall back to it.
export HDF5_URL="https://github.com/HDFGroup/hdf5/releases/download/hdf5-${HDF5_VERSION}/hdf5-${HDF5_VERSION}.tar.gz"
export HDF5_URL_ALT="https://github.com/HDFGroup/hdf5/releases/download/hdf5_${HDF5_VERSION}/hdf5-${HDF5_VERSION}.tar.gz"

export NETCDF_C_VERSION=4.9.3
export NETCDF_C_URL="https://downloads.unidata.ucar.edu/netcdf-c/${NETCDF_C_VERSION}/netcdf-c-${NETCDF_C_VERSION}.tar.gz"
export NETCDF_C_URL_ALT="https://github.com/Unidata/netcdf-c/archive/refs/tags/v${NETCDF_C_VERSION}.tar.gz"

export NETCDF_FORTRAN_VERSION=4.6.2
export NETCDF_FORTRAN_URL="https://downloads.unidata.ucar.edu/netcdf-fortran/${NETCDF_FORTRAN_VERSION}/netcdf-fortran-${NETCDF_FORTRAN_VERSION}.tar.gz"
export NETCDF_FORTRAN_URL_ALT="https://github.com/Unidata/netcdf-fortran/archive/refs/tags/v${NETCDF_FORTRAN_VERSION}.tar.gz"

export SPARTA_TAG=27Aug2026
export SPARTA_URL="https://github.com/sparta/sparta/archive/refs/tags/${SPARTA_TAG}.tar.gz"
