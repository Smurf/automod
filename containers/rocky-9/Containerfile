ARG DIST="9"
FROM rockylinux:9
ARG DIST
ENV DEBIAN_FRONTEND=noninteractive

# Base toolchain + libraries for compiling the automod module stack.
# EPEL provides Lmod, CRB provides libfabric-devel; everything built here is
# produced and validated inside this same container.
RUN dnf -q install -y epel-release dnf-plugins-core \
    && dnf -q config-manager --set-enabled crb \
    && dnf -q install -y \
        gcc gcc-c++ gcc-gfortran \
        make cmake pkgconf-pkg-config \
        wget curl ca-certificates gnupg2 \
        tar gzip xz bzip2 unzip file m4 perl \
        bison flex findutils procps \
        zlib-devel libfabric libfabric-devel \
        Lmod python3 \
    && dnf -q clean all

# lmod init + point module lookups at the automod scope trees mounted at
# /opt/automod (mpi/, libs/, apps/, compilers/ each becomes a MODULEPATH root).
# EPEL's Lmod uses a versioned init path (/usr/share/lmod/<ver>/init/bash),
# unlike Ubuntu's /usr/share/lmod/lmod/init/bash, so resolve it dynamically.
RUN printf '#!/bin/bash\n_l="$(ls -1d /usr/share/lmod/*/init/bash 2>/dev/null | sort -V | tail -1)"\n[[ -n "$_l" ]] && source "$_l"\n' \
        > /etc/profile.d/91-lmod.sh \
    && printf 'for _d in mpi libs apps compilers; do [ -d /opt/automod/modulefiles/$_d ] && module use /opt/automod/modulefiles/$_d; done; unset _d\n' \
        > /etc/profile.d/92-automod-modulepath.sh \
    && chmod 0644 /etc/profile.d/91-lmod.sh /etc/profile.d/92-automod-modulepath.sh

ARG DIST
LABEL org.opencontainers.image.description="automod HPC module builder (Rocky Linux ${DIST})"
